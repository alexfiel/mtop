generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------
// Better-Auth Core Models
// ---------------------------------------------
model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Roles Relationship
  roles UserRole[]

  sessions  Session[]
  accounts  Account[]
  auditLogs AuditLog[]
  tasks     FranchiseTasks[]
  profile   UserProfile?
  vehicle   MTOPVehicle?
}

model UserProfile {
  id          String    @id @default(cuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  contactNo   String?
  jobTitle    String?
  department  String?
  office      String?
  dateOfBirth DateTime?
  address     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt
}

model Role {
  id         String  @id @default(cuid())
  name       String  @unique
  function   String?
  capability String?

  users UserRole[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserRole {
  id     String @id @default(cuid())
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, roleId])
}

// ---------------------------------------------
// MTOP Core Models
// ---------------------------------------------

enum FranchiseStatus {
  PENDING
  FOR_BILLING
  FOR_PAYMENT
  FOR_SP_APPROVAL
  APPROVED
  PUBLISHED
  ACTIVE
  SUSPENDED
  REVOKED
}

enum TricycleStatus {
  PENDING
  FOR_SP_APPROVAL
  APPROVED
  PUBLISHED
  ACTIVE
  SUSPENDED
  REVOKED
}

enum DriverStatus {
  ACTIVE
  SUSPENDED
  REVOKED
}

enum PermitStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

enum ApplicationStatus {
  PENDING
  FOR_SP_APPROVAL
  APPROVED
  PUBLISHED
  ACTIVE
  SUSPENDED
  REVOKED
}

enum PaymentStatus {
  PAID
  UNPAID
}

enum DocumentType {
  NEW_APPLICATION
  RENEWAL
  RETIREMENT
}

model BodyNumber {
  bodyNumber  Int        @id
  franchiseId String?    @unique
  franchise   Franchise? @relation(fields: [franchiseId], references: [id])
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model NewFranchise {
  id                  String   @id @default(cuid())
  franchiseBodyNumber Int      @unique
  operatorId          String?  @unique
  operator            Operator? @relation(fields: [operatorId], references: [id])
  zone                String? @default("Tagbilaran City")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  //MTOP Vehicle Relation
  mtopVehicleId String?      @unique
  mtopVehicle   MTOPVehicle? @relation("NewFranchiseVehicle", fields: [mtopVehicleId], references: [id])

  // Application relations
  currentApplicationId String?                @unique
  currentApplication   FranchiseApplication?  @relation("CurrentNewFranchiseApplication", fields: [currentApplicationId], references: [id])
  applications         FranchiseApplication[] @relation("NewFranchiseApplications")

  // Tasks relation
  tasks FranchiseTasks[]
  isActive Boolean @default(false)
  isAssigned Boolean @default(false)
  assignedDate DateTime?
  remarks String?    
}

model Operator {
  id                String    @id @default(cuid())
  operatorId        String    @unique
  name              String    @unique
  address           String
  email             String    @unique
  mobileNo          String    @unique
  dateOfBirth       DateTime
  validIDType       String
  validIDNumber     String    @unique
  validIDExpiryDate DateTime
  profilePicture    String?
  validIdFront      String?
  validIdBack       String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  encodedBy         String
  encodedDate       DateTime  @default(now())
  updatedBy         String?
  updatedDate       DateTime? @updatedAt
  status            String    @default("PENDING")
  isVerified        Boolean   @default(false)
  verifiedBy        String?
  verifiedDate      DateTime?
  approvedBy        String?
  approvedDate      DateTime?

  // One-to-One Relations
  newFranchise NewFranchise?
  vehicle      MTOPVehicle?
}

model MTOPVehicle {
  id                  String @id @default(cuid())
  registeredOwnerName String
  registeredAddress   String
  make                String
  model               String
  year                Int
  plateNumber         String @unique
  engineNumber        String
  chassisNumber       String
  color               String
  registrationNumber  String @unique

  // one to one with operator
  operatorId String   @unique
  operator   Operator @relation(fields: [operatorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User?   @relation(fields: [userId], references: [id])
  userId String? @unique

  // One to One New Franchise (Virtual inverse side)
  newFranchise NewFranchise? @relation("NewFranchiseVehicle")
}

model FranchiseApplication {
  id             String          @id @default(cuid())
  mtopNo         String?         @unique
  appyear        Int
  apptype        String
  resolutionNo   String?
  resolutionDate DateTime?
  remarks        String?
  status         String          @default("PENDING")
  approvedBy     String?
  approvedDate   DateTime?
  taskId         String?
  task           FranchiseTasks? @relation(fields: [taskId], references: [id])
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  // Relation with NewFranchise
  newFranchiseId      String?
  newFranchise        NewFranchise? @relation("NewFranchiseApplications", fields: [newFranchiseId], references: [id])
  newFranchiseCurrent NewFranchise? @relation("CurrentNewFranchiseApplication")

  // Backward compatibility with legacy Franchise model
  franchiseId      String?
  franchise        Franchise? @relation("FranchiseApplications", fields: [franchiseId], references: [id])
  franchiseCurrent Franchise? @relation("CurrentApplication")
}

model FranchiseTasks {
  id           String                 @id @default(cuid())
  office       String
  taskname     String
  taskdesc     String
  userId       String
  user         User                   @relation(fields: [userId], references: [id])
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  applications FranchiseApplication[]

  // Relation with NewFranchise
  newFranchiseId String?
  newFranchise   NewFranchise? @relation(fields: [newFranchiseId], references: [id])
}

model Franchise {
  id          String   @id @default(cuid())
  franchiseNo String   @unique
  ownerName   String   @unique
  address     String
  contactNo   String
  email       String   @unique
  dateOfBirth DateTime

  // Additional Franchise Details
  resolutionNo         String?
  approvedOn           DateTime?
  areaOfOperation      String?
  currentApplicationId String?                @unique
  currentApplication   FranchiseApplication?  @relation("CurrentApplication", fields: [currentApplicationId], references: [id])
  applications         FranchiseApplication[] @relation("FranchiseApplications")

  status    String    @default("PENDING") // PENDING, FOR_SP_APPROVAL, APPROVED, PUBLISHED, ACTIVE, SUSPENDED, REVOKED
  isRenewal Boolean   @default(false)
  issuedAt  DateTime  @default(now())
  expiresAt DateTime?

  tricycle Tricycle?

  bodyNumber BodyNumber?

  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  franchiseTransactions FranchiseTransaction[]
}

model FranchiseTransaction {
  id              String    @id @default(cuid())
  franchiseId     String
  franchise       Franchise @relation(fields: [franchiseId], references: [id])
  transactionType String //renewal, payment, etc
  paymentStatus   String //paid, unpaid, etc.
  amount          Float
  paymentDate     DateTime
  orNumber        String    @unique
  remarks         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Driver {
  id             String   @id @default(cuid())
  firstName      String
  lastName       String
  middleName     String?
  licenseNo      String   @unique
  address        String
  contactNo      String
  email          String   @unique
  dateOfBirth    DateTime
  status         String   @default("ACTIVE") // ACTIVE, SUSPENDED, REVOKED
  profilePicture String?

  mainTricycles  Tricycle[]  @relation("MainDriver")
  extraTricycles Tricycle[]  @relation("ExtraDriver")
  violations     Violation[]
  documents      Document[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Tricycle {
  id         String @id @default(cuid())
  make       String
  model      String
  color      String
  plateNo    String @unique
  chassisNo  String @unique
  motorNo    String @unique
  bodyNumber String @unique
  status     String @default("ACTIVE") // ACTIVE, SUSPENDED, REVOKED

  mainDriverId String?
  mainDriver   Driver? @relation("MainDriver", fields: [mainDriverId], references: [id])

  extraDriverId String?
  extraDriver   Driver? @relation("ExtraDriver", fields: [extraDriverId], references: [id])

  franchiseId String    @unique
  franchise   Franchise @relation(fields: [franchiseId], references: [id])

  permits    Permit[]
  violations Violation[]
  documents  Document[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Permit {
  id        String   @id @default(cuid())
  permitNo  String   @unique
  status    String   @default("ACTIVE") // ACTIVE, EXPIRED, REVOKED
  issuedAt  DateTime @default(now())
  expiresAt DateTime

  tricycleId String
  tricycle   Tricycle @relation(fields: [tricycleId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ViolationType is customizable by admin
model ViolationType {
  id          String @id @default(cuid())
  code        String @unique
  description String
  fineAmount  Float

  violations Violation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Violation {
  id       String   @id @default(cuid())
  ticketNo String   @unique
  remarks  String?
  status   String   @default("UNPAID") // UNPAID, PAID, SETTLED
  issuedAt DateTime @default(now())

  violationTypeId String
  type            ViolationType @relation(fields: [violationTypeId], references: [id])

  driverId String?
  driver   Driver? @relation(fields: [driverId], references: [id])

  tricycleId String?
  tricycle   Tricycle? @relation(fields: [tricycleId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Document {
  id           String @id @default(cuid())
  fileUrl      String
  fileType     String // IMAGE, PDF, etc.
  documentType String // e.g., DRIVERS_LICENSE, OR_CR, CLEARANCE

  driverId String?
  driver   Driver? @relation(fields: [driverId], references: [id])

  tricycleId String?
  tricycle   Tricycle? @relation(fields: [tricycleId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FeeRule {
  id              String  @id @default(cuid())
  applicationType String // "NEW", "RENEWAL", "RETIREMENT"
  description     String // e.g., "Mayor's Permit Fee", "Filing Fee", "Penalty"
  amount          Float
  isActive        Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------
// Universal Audit Log
// ---------------------------------------------
model AuditLog {
  id       String @id @default(cuid())
  entity   String // e.g. "Tricycle", "Driver", "Franchise"
  entityId String // The ID of the record being changed
  action   String // "CREATE", "UPDATE", "DELETE"
  changes  String // JSON string of changes

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
}

model ItemAccounts {
  id             String  @id @default(cuid())
  account_name   String
  account_number String  @unique
  default_amount Float   @default(0)
  isActive       Boolean @default(true)
  fundtype       String //General Fund, Trust Fund, Motorized Vehicle Fund

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
